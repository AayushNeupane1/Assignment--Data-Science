   "source": [
    "import re\n",
    "\n",
    "text = \" play playing sing ring bring walking coding \"\n",
    "\n",
    "stemmed_words = [\n",
    "    w[:-3]\n",
    "    for w in text.split()\n",
    "    if re.match(r\".*[aeiou].*ing$\", w)\n",
    "]\n",
    "\n",
    "print(\" \".join(stemmed_words))"
   ]
